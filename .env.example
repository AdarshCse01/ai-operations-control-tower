# ==============================================================================
# AI Operations Control Tower - Environment Configuration Template
# ==============================================================================
# ENVIRONMENT PROFILES:
#
# 1. DEVELOPMENT (Local SQLite Fallback & Demo Mode):
#    APP_ENV=development
#    ALLOW_SQLITE_FALLBACK=true
#    ENABLE_DEMO_LOGINS=true
#    COOKIE_SECURE=false
#
# 2. STAGING (Pre-release Validation Gate with Real PostgreSQL & Redis):
#    APP_ENV=staging
#    SECRET_KEY=<generate_at_least_32_random_bytes>
#    ALLOW_SQLITE_FALLBACK=false
#    ENABLE_DEMO_LOGINS=false
#    COOKIE_SECURE=true
#    CORS_ORIGINS=https://staging.opscontrol.internal
#    ALLOWED_HOSTS=staging.opscontrol.internal,backend
#
# 3. PRODUCTION (Strict Zero-Trust & Maximum Hardening):
#    APP_ENV=production
#    SECRET_KEY=<generate_at_least_64_random_hex_characters>
#    ALLOW_SQLITE_FALLBACK=false
#    ENABLE_DEMO_LOGINS=false
#    COOKIE_SECURE=true
#    CORS_ORIGINS=https://opscontrol.company.com
#    ALLOWED_HOSTS=opscontrol.company.com
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# Cryptographic Secret Key (min 32 characters in staging/production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-secure-32-byte-hex-secret-in-production

# Operational Reliability Controls (MUST be false in staging and production)
ALLOW_SQLITE_FALLBACK=true
ENABLE_DEMO_LOGINS=true

# Database Credentials & Connection
POSTGRES_USER=ops
POSTGRES_PASSWORD=replace-with-secure-database-password
POSTGRES_DB=ops_control
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Primary PostgreSQL async connection string:
# For Docker Compose: postgresql+asyncpg://ops:<password>@postgres:5432/ops_control
# For Local Host:     postgresql+asyncpg://ops:<password>@localhost:5432/ops_control
DATABASE_URL=postgresql+asyncpg://ops:replace-with-secure-database-password@localhost:5432/ops_control

# Redis Cache & Distributed Rate Limiting
# For Docker Compose: redis://redis:6379/0
# For Local Host:     redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Network & Host Protection
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*

# Authentication & Session Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend API Endpoint (consumed during frontend build/runtime)
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEMO_LOGINS=true

# Optional AI Provider Configuration
AI_PROVIDER=none
AI_API_KEY=

